{
  "name": "students-api-ci",
  "version": "1.0.0",
  "private": true,
  "description": "API REST d'annuaire étudiant et pipeline CI — TP chapitre 1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:coverage": "c8 --all --include=src/**/*.js --exclude=src/server.js --reporter=text --reporter=lcov node --test",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "c8": "10.1.3",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "supertest": "7.3.1"
  }
}
